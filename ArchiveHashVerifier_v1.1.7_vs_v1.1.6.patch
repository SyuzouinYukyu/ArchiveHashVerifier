+++ b/ArchiveHashVerifier.Tests/V117TestCases.cs
@@ -0,0 +1,26 @@
+using ArchiveHashVerifier;
+
+internal static class V117TestCases
+{
+    public static Task SavedKeyMetadataPresentationAndLookup()
+    {
+        const string primary = "00112233445566778899AABBCCDDEEFF00112233";
+        const string signing = "AABBCCDDEEFF00112233445566778899AABBCCDD";
+        var key = new GpgKey("ArchiveHashVerifier Test User <ahv-test@example.invalid>", "ArchiveHashVerifier Test User", "ahv-test@example.invalid",
+            "ed25519", null, primary, [signing]);
+
+        Equal("署名鍵: 未選択", MainForm.FormatSavedKeyLabel(null));
+        Equal(key.UserId, MainForm.FindSavedGpgKey([key], primary.ToLowerInvariant())?.UserId);
+        Equal(key.UserId, MainForm.FindSavedGpgKey([key], signing.ToLowerInvariant())?.UserId);
+        Equal(null, MainForm.FindSavedGpgKey([key], "FFEEDDCCBBAA99887766554433221100FFEEDDCC"));
+        Equal($"署名鍵: {key.UserId} / {primary}", MainForm.FormatSavedKeyLabel(primary, key.UserId));
+        Equal($"署名鍵: 保存済み（GPG利用不可） / {primary}", MainForm.FormatSavedKeyLabel(primary, savedState: "保存済み（GPG利用不可）"));
+        Equal($"署名鍵: 保存済み（現在利用不可） / {primary}", MainForm.FormatSavedKeyLabel(primary, savedState: "保存済み（現在利用不可）"));
+        return Task.CompletedTask;
+    }
+
+    private static void Equal<T>(T expected, T actual)
+    {
+        if (!EqualityComparer<T>.Default.Equals(expected, actual)) throw new InvalidOperationException($"Expected {expected}; actual {actual}");
+    }
+}
